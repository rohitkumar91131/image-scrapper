# ZenRows — Get free 1000 req at https://app.zenrows.com/signup
# Add this to .env (local) and Vercel Dashboard -> Settings -> Environment Variables (prod)
ZENROWS_API_KEY=your_zenrows_api_key_here

# Optional: add ScrapingBee / ScraperAPI as fallback (not needed if ZenRows set)
# SCRAPERAPI_KEY=
# ZENROWS_JS_RENDER=false  # set true for heavy JS sites like unsplash (costs more)
